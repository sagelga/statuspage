{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "statuspage",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-03-16",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "status.sagelga.com", "custom_domain": true }
  ],
  "placement": {
    "mode": "smart"
  },
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "STATUS_HISTORY",
      "id": "80e2c1af6de14efba5d68e03e1f71f28"
    }
  ]
}
